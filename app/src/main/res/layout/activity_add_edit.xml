<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootAddEdit"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_blush"
    android:orientation="vertical"
    tools:context=".ui.addedit.AddEditActivity">

    <!-- ============ Toolbar ============ -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/text_primary"
        app:title="Add Appliance"
        app:titleTextColor="@color/text_primary"
        app:titleCentered="false"/>

    <!-- ============ Scrollable content ============ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Type section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose a type"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.05"
                android:textAllCaps="true"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTypes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="6"
                tools:listitem="@layout/item_type_option"/>

            <!-- Name section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Name"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.05"
                android:textAllCaps="true"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/nameInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxStrokeColor="@color/rose_primary"
                app:hintTextColor="@color/rose_primary"
                app:boxCornerRadiusTopStart="@dimen/corner_button"
                app:boxCornerRadiusTopEnd="@dimen/corner_button"
                app:boxCornerRadiusBottomStart="@dimen/corner_button"
                app:boxCornerRadiusBottomEnd="@dimen/corner_button">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. Bedroom Light"
                    android:inputType="textCapSentences"
                    android:maxLines="1"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- GPIO pin section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="GPIO pin"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.05"
                android:textAllCaps="true"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/pinInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxStrokeColor="@color/rose_primary"
                app:hintTextColor="@color/rose_primary"
                app:boxCornerRadiusTopStart="@dimen/corner_button"
                app:boxCornerRadiusTopEnd="@dimen/corner_button"
                app:boxCornerRadiusBottomStart="@dimen/corner_button"
                app:boxCornerRadiusBottomEnd="@dimen/corner_button">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/etPin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select a pin"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true"/>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvPinHelper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Pins already in use are unavailable"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ============ Save button (sticky at bottom) ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        android:background="@color/bg_blush"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save appliance"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:textColor="@color/rose_on_primary"
            app:backgroundTint="@color/rose_primary"
            app:cornerRadius="@dimen/corner_button"
            app:icon="@drawable/ic_check"
            app:iconTint="@color/rose_on_primary"
            app:iconGravity="textStart"
            app:iconPadding="8dp"/>

    </FrameLayout>

</LinearLayout>