<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootProfile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_blush"
    android:orientation="vertical" >
<!--    tools:context=".ui.profile.ProfileActivity">-->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/text_primary"
        app:title="Profile"
        app:titleTextColor="@color/text_primary"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your profile"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:letterSpacing="-0.01"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Personalize your app"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Your name"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.05"
                android:textAllCaps="true"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/userNameLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxStrokeColor="@color/rose_primary"
                app:hintTextColor="@color/rose_primary"
                app:boxCornerRadiusTopStart="@dimen/corner_button"
                app:boxCornerRadiusTopEnd="@dimen/corner_button"
                app:boxCornerRadiusBottomStart="@dimen/corner_button"
                app:boxCornerRadiusBottomEnd="@dimen/corner_button">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUserName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. Collins"
                    android:inputType="textCapWords"
                    android:maxLines="1"/>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="House name"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.05"
                android:textAllCaps="true"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/houseNameLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxStrokeColor="@color/rose_primary"
                app:hintTextColor="@color/rose_primary"
                app:boxCornerRadiusTopStart="@dimen/corner_button"
                app:boxCornerRadiusTopEnd="@dimen/corner_button"
                app:boxCornerRadiusBottomStart="@dimen/corner_button"
                app:boxCornerRadiusBottomEnd="@dimen/corner_button"
                app:helperText="Shown at the top of your home screen">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etHouseName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. Mensah House"
                    android:inputType="textCapWords"
                    android:maxLines="1"/>

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="Save profile"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:textColor="@color/rose_on_primary"
                app:backgroundTint="@color/rose_primary"
                app:cornerRadius="@dimen/corner_button"
                app:icon="@drawable/ic_check"
                app:iconTint="@color/rose_on_primary"
                app:iconGravity="textStart"
                app:iconPadding="8dp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>