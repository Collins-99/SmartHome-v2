<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootSetup"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_blush"
    android:fillViewport="true"
    tools:context=".ui.setup.SetupActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="72dp"
        android:paddingBottom="32dp"
        android:gravity="center_horizontal">

        <!-- House illustration -->
        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal">

            <View
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_empty_glow"/>

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_home_outline"
                android:tint="@color/rose_primary"
                android:contentDescription="Home"/>

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Connect your home"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:letterSpacing="-0.01"
            android:textAlignment="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enter the IP address of your ESP32"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:textAlignment="center"/>

        <!-- IP field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ipInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:boxStrokeColor="@color/rose_primary"
            app:hintTextColor="@color/rose_primary"
            app:boxCornerRadiusTopStart="@dimen/corner_button"
            app:boxCornerRadiusTopEnd="@dimen/corner_button"
            app:boxCornerRadiusBottomStart="@dimen/corner_button"
            app:boxCornerRadiusBottomEnd="@dimen/corner_button"
            app:helperText="Read it from the Arduino serial monitor after the ESP32 boots">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="192.168.1.42"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:maxLines="1"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Test connection button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Test connection &amp; save"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:textColor="@color/rose_on_primary"
            app:backgroundTint="@color/rose_primary"
            app:cornerRadius="@dimen/corner_button"/>

        <!-- Status text -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text=""
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:textAlignment="center"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>