<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================
         Base theme — everything inherits from this.
         Material 3 colour tokens map our rose palette into Android.
         ============================================================ -->
    <style name="Base.Theme.SmartHome" parent="Theme.Material3.Light.NoActionBar">

        <!-- Primary (rose) -->
        <item name="colorPrimary">@color/rose_primary</item>
        <item name="colorOnPrimary">@color/rose_on_primary</item>
        <item name="colorPrimaryContainer">@color/rose_container</item>
        <item name="colorOnPrimaryContainer">@color/rose_on_container</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/rose_secondary</item>
        <item name="colorOnSecondary">@color/rose_on_secondary</item>

        <!-- Backgrounds -->
        <item name="android:colorBackground">@color/bg_blush</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Outline -->
        <item name="colorOutline">@color/outline</item>

        <!-- Error -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">#FFFFFF</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/bg_blush</item>
        <item name="android:navigationBarColor">@color/bg_blush</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- Typography defaults (Roboto, Material 3 scale) -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>

        <!-- Motion -->
        <item name="motionDurationShort1">@integer/duration_short</item>
        <item name="motionDurationMedium1">@integer/duration_medium</item>
        <item name="motionDurationLong1">@integer/duration_long</item>

        <!-- Material components -->
        <item name="materialButtonStyle">@style/Widget.SmartHome.Button</item>
        <item name="floatingActionButtonStyle">@style/Widget.SmartHome.FAB</item>
        <item name="materialCardViewStyle">@style/Widget.SmartHome.Card</item>
        <item name="switchStyle">@style/Widget.SmartHome.Switch</item>
    </style>

    <!-- Active theme -->
    <style name="Theme.SmartHome" parent="Base.Theme.SmartHome" />

    <!-- ============================================================
         Component styles. Centralizing these means every button,
         card, FAB, switch looks consistent across the whole app.
         ============================================================ -->

    <style name="Widget.SmartHome.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/corner_button</item>
        <item name="backgroundTint">@color/rose_primary</item>
        <item name="android:textColor">@color/rose_on_primary</item>
    </style>

    <style name="Widget.SmartHome.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/rose_primary</item>
        <item name="tint">@color/rose_on_primary</item>
        <item name="elevation">@dimen/elevation_fab</item>
    </style>

    <style name="Widget.SmartHome.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_card</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <style name="Widget.SmartHome.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/rose_switch_thumb</item>
        <item name="trackTint">@color/rose_switch_track</item>
    </style>

</resources>